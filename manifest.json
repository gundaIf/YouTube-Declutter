{
  "manifest_version": 3,
  "name": "YouTube Declutter",
  "version": "2.0.0",
  "description": "Use YouTube intentionally. Pick how each session runs, set your own limits, hide what you want, then stop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Declutter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-enabled": { "description": "Turn YouTube Declutter on or off" },
    "pause-15": { "description": "Pause for 15 minutes" },
    "end-session": { "description": "End the current session" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "css": ["styles.css"],
      "js": ["shared.js", "content.js", "ambient.js"],
      "run_at": "document_start"
    }
  ]
}
